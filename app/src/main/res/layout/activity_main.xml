<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="AMARTE"
                android:textColor="#212529"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:gravity="center"
                android:text="Inicia sesión para continuar"
                android:textColor="#6C757D"
                android:textSize="16sp" />

            <!-- CORREO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Correo electrónico"
                app:boxBackgroundColor="#FFFFFF"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="#6C757D"
                app:hintTextColor="#495057">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txteEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:padding="16dp"
                    android:textColor="#212529"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Contraseña"
                app:boxBackgroundColor="#FFFFFF"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="#6C757D"
                app:endIconMode="password_toggle"
                app:hintTextColor="#495057">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:padding="16dp"
                    android:textColor="#212529"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CHECKBOX MANTENER SESIÓN INICIADA -->
            <CheckBox
                android:id="@+id/chkMantenerSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Mantener sesión iniciada"
                android:textColor="#495057"
                android:buttonTint="#212529" />

            <!-- BOTÓN INICIAR SESIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="INICIAR SESIÓN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#212529"
                app:cornerRadius="18dp"
                app:elevation="5dp" />

            <!-- BOTÓN REGISTRARSE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrRegistro"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="REGISTRARSE"
                android:textColor="#212529"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:strokeColor="#212529"
                app:strokeWidth="2dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>